{
  "name": "hongguo-desktop",
  "productName": "HongguoDuanju",
  "version": "1.1.1",
  "private": true,
  "description": "红果短剧桌面客户端(官方网页版封装壳)",
  "main": "main.js",
  "author": "huyang-md",
  "repository": {
    "type": "git",
    "url": "https://github.com/huyang-md/hongguo-desktop-wrapper.git"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.local.hongguoduanju",
    "productName": "HongguoDuanju",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "error.html",
      "assets/**"
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "shortcutName": "红果短剧"
    }
  }
}
